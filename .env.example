# INI CUMA CONTOH — file .env sebenarnya TIDAK dipakai di alur "tanpa laptop".
# Isi 4 nilai ini nanti langsung di Vercel Dashboard -> Project -> Settings
# -> Environment Variables (lewat browser HP juga bisa).

DISCORD_APP_ID=isi_application_id_di_sini
DISCORD_PUBLIC_KEY=isi_public_key_di_sini
DISCORD_BOT_TOKEN=isi_bot_token_di_sini

# Bebas kamu isi sendiri, string acak apa aja (contoh: kata sandi baru).
# Ini "kunci" biar cuma kamu yang bisa buka /api/register di browser.
REGISTER_SECRET=isi_dengan_kata_rahasia_bebas

# OPSIONAL. Kalau diisi, bot cuma mau merespon command "/convert" di
# channel dengan ID ini aja (channel lain bakal ditolak). Kosongin /
# hapus baris ini di Vercel kalau mau bot bisa dipakai di semua channel.
# Cara ambil channel ID: klik kanan/tekan lama nama channel di Discord ->
# "Copy Channel ID" (Developer Mode harus aktif dulu di Discord Settings).
ALLOWED_CHANNEL_ID=isi_channel_id_di_sini
